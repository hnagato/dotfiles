# Note
# docs:
# ghostty +show-config --default --docs | less
# examples:
# https://github.com/search?q=path%3Aghostty%2Fconfig&type=code

theme = light:Flexoki Light,dark:Kanagawa Dragon

font-family = Berkeley Mono
font-family = Juisee
adjust-cell-height = 10%

background-opacity = 0.9
background-blur = macos-glass-regular

shell-integration-features = no-title,no-cursor
cursor-style = block

macos-option-as-alt = true
macos-non-native-fullscreen = true
macos-titlebar-style = hidden
macos-window-buttons = hidden
focus-follows-mouse = true

window-width = 160
window-height = 80

# keybind = ctrl+cmd+h=goto_split:left
# keybind = ctrl+cmd+j=goto_split:bottom
# keybind = ctrl+cmd+k=goto_split:top
# keybind = ctrl+cmd+l=goto_split:right
# keybind = alt+cmd+h=resize_split:left,30
# keybind = alt+cmd+j=resize_split:down,30
# keybind = alt+cmd+k=resize_split:up,30
# keybind = alt+cmd+l=resize_split:right,30
keybind = cmd+shift+[=text:\x1a\x10
keybind = cmd+shift+]=text:\x1a\x0e
# pass through to herdr
keybind = cmd+t=unbind
keybind = cmd+w=unbind
keybind = cmd+d=unbind
keybind = cmd+shift+d=unbind
keybind = cmd+shift+enter=unbind
keybind = ctrl+cmd+h=unbind
keybind = ctrl+cmd+j=unbind
keybind = ctrl+cmd+k=unbind
keybind = ctrl+cmd+l=unbind

keybind = shift+enter=text:\n

# Workaround
# https://github.com/ghostty-org/ghostty/issues/3320
keybind = ctrl+m=text:\x0D
keybind = ctrl+i=text:\x09
keybind = ctrl+[=text:\x1B

# custom-shader = ./shaders/cursor_smear.glsl
# custom-shader = ./shaders/cursor_frozen.glsl
# custom-shader = ./shaders/cursor_glide.glsl

# Per-machine overrides such as font-size; config.local selects config.personal or config.work
config-file = ?config.local
